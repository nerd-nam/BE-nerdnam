# 이 파일을 .env로 복사한다. 기존 .env가 있으면 필요한 항목만 추가한다.
# Docker Compose는 .env를 자동으로 읽는다. IntelliJ·bootRun은 별도로 환경변수를 넣어야 한다.
# .env가 없어도 docker compose up으로 API·DB·Redis가 실행된다.

# FE 연결은 session. 로그인 없이 API만 시험할 때는 header + X-Member-Id: 1.
NERDNAM_AUTH_MODE=session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 브라우저에서 접속하는 FE 주소. 끝에 /를 붙이지 않는다.
WEB_ORIGIN=http://localhost:3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
# 기본 콜백 주소는 http://localhost:${API_PORT}/login/oauth2/code/google (카카오는 /kakao).
# 다른 호스트 이름을 쓸 때만 지정한다. 끝에 /를 붙이지 않는다.
# API_PUBLIC_URL=http://localhost:8080

# 기본값은 Java 내부 AI 스텁. 실제 FastAPI와 연결할 때 false.
NERDNAM_AI_STUB=true
NERDNAM_AI_BASE_URL=http://host.docker.internal:8000
